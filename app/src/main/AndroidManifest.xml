<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="ai.moonshine.voice" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".SmolChatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/nova_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@drawable/nova_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmolLMAndroid"
        tools:targetApi="31">
        <activity
            android:name=".NovaActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SmolLMAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.screens.manage_asr.ManageASRActivity"
            android:exported="false"
            android:label="@string/title_activity_app_settings"
            android:theme="@style/Theme.SmolLMAndroid" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SmolLMAndroid" />
        <activity
            android:name=".ui.screens.chat.ChatActivity"
            android:exported="true"
            android:label="💬 LLM">

            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.screens.model_download.DownloadModelActivity" />
        <activity android:name=".ui.screens.manage_tasks.ManageTasksActivity" />
    </application>

</manifest>
